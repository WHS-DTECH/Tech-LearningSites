---
layout: layouts/base.njk
---
<section class="course-masthead">
  <div class="page-shell course-masthead-inner">
    <div class="course-kicker">{{ shortTitle or title }}</div>
    <div class="course-title-frame">
      <h1>
        {% if titleLines %}
          {% for line in titleLines %}
            <span class="course-title-line">{{ line }}</span>
          {% endfor %}
        {% else %}
          {{ displayTitle or title }}
        {% endif %}
      </h1>
    </div>
    {% if summary %}
      <p class="course-summary">{{ summary }}</p>
    {% endif %}
  </div>
</section>

<section class="page-shell course-panel">
  {% if assessments %}
    <div class="course-block course-assessments">
      <h2>Assessments</h2>
      <ul id="course-assessments-list">
        {% for item in assessments %}
          <li>
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.code }}</a>
            {% else %}
              <span>{{ item.code }}</span>
            {% endif %}
            {% if item.text %}
              <span> {{ item.text }}</span>
            {% endif %}
            {% if item.credits %}
              <span> - {{ item.credits }} credits</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if assessmentLinks %}
    <nav class="course-chip-row" aria-label="Course resources" id="course-chip-row">
      {% if assessmentGroup %}
        {% for link in assessmentLinks %}
          {% if loop.index == assessmentGroup.start %}
            <div class="course-chip-group" aria-label="{{ assessmentGroup.ariaLabel or 'Assessment links' }}">
          {% endif %}

          <a
            class="course-chip{% if loop.index >= assessmentGroup.start and loop.index <= assessmentGroup.end %} course-chip-assessment{% endif %}"
            href="{{ link.url }}"
            {% if link.newTab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {{ link.label }}
          </a>

          {% if loop.index == assessmentGroup.end %}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for link in assessmentLinks %}
          <a class="course-chip" href="{{ link.url }}" {% if link.newTab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
        {% endfor %}
      {% endif %}
    </nav>
  {% endif %}

  <details class="course-statement" {% if statement and statement.open %}open{% endif %}>
    <summary>
      <span>{{ statement.title or "Assessment statement" }}</span>
      <span class="course-chevron" aria-hidden="true"></span>
    </summary>

    <div class="course-statement-body" id="course-statement-body" data-default-height="{{ statement.height or 1000 }}">
      {% if statement and statement.embedUrl %}
        <div class="course-embed-frame">
          <iframe
            src="{{ statement.embedUrl }}"
            title="{{ statement.title or 'Assessment statement' }}"
            loading="lazy"
            referrerpolicy="no-referrer"
            style="height: {{ statement.height or 1000 }}px;"
          ></iframe>
        </div>
      {% elif statement and statement.downloadUrl %}
        <p>
          Assessment statement available here:
          <a href="{{ statement.downloadUrl }}">Open statement document</a>
        </p>
      {% else %}
        <p>Add an embedUrl or downloadUrl in this page frontmatter to show the statement file.</p>
      {% endif %}
    </div>
  </details>

  {% if not hideContent %}
    <div class="course-body">
      {% if lead %}
        <p class="course-lead">{{ lead }}</p>
      {% endif %}
      <div class="content-body">
        {{ content | safe }}
      </div>
    </div>
  {% endif %}
</section>

{% if contentApiCourseCode %}
  <script>
    (async () => {
      const courseCode = "{{ contentApiCourseCode }}";

      try {
        const response = await fetch(`/api/course-content/${courseCode}`, { credentials: "same-origin" });
        const data = await response.json();

        if (!response.ok || data.ok === false) {
          return;
        }

        const assessmentsList = document.getElementById("course-assessments-list");
        if (assessmentsList && Array.isArray(data.assessments) && data.assessments.length) {
          assessmentsList.innerHTML = data.assessments
            .map((item) => `<li><span>${String(item).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span></li>`)
            .join("");
        }

        const chipRow = document.getElementById("course-chip-row");
        if (chipRow && Array.isArray(data.assessmentLinks) && data.assessmentLinks.length) {
          const groupStart = {{ assessmentGroup.start if assessmentGroup else 0 }};
          const groupEnd = {{ assessmentGroup.end if assessmentGroup else 0 }};
          let html = "";

          data.assessmentLinks.forEach((link, index) => {
            const oneBased = index + 1;

            if (groupStart && oneBased === groupStart) {
              html += `<div class=\"course-chip-group\" aria-label=\"{{ assessmentGroup.ariaLabel or 'Assessment links' }}\">`;
            }

            const label = String(link.label || "")
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;");
            const url = String(link.url || "#")
              .replace(/\"/g, "&quot;");

            const className = groupStart && oneBased >= groupStart && oneBased <= groupEnd
              ? "course-chip course-chip-assessment"
              : "course-chip";

            html += `<a class=\"${className}\" href=\"${url}\">${label}</a>`;

            if (groupEnd && oneBased === groupEnd) {
              html += "</div>";
            }
          });

          chipRow.innerHTML = html;
        }

        const statementBody = document.getElementById("course-statement-body");
        if (statementBody && data.statementUrl) {
          const frameHeight = Number.parseInt(statementBody.dataset.defaultHeight, 10) || 1000;
          statementBody.innerHTML = `
            <div class=\"course-embed-frame\">
              <iframe
                src=\"${data.statementUrl}\"
                title=\"Assessment statement\"
                loading=\"lazy\"
                referrerpolicy=\"no-referrer\"
                style=\"height: ${frameHeight}px;\"
              ></iframe>
            </div>
          `;
        }
      } catch (error) {
        console.error("Unable to load dynamic course content", error);
      }
    })();
  </script>
{% endif %}
