---
layout: layouts/base.njk
---
<section class="course-masthead">
  <div class="page-shell course-masthead-inner">
    <div class="course-kicker">{{ shortTitle or title }}</div>
    <div class="course-title-frame">
      <h1>
        {% if titleLines %}
          {% for line in titleLines %}
            <span class="course-title-line">{{ line }}</span>
          {% endfor %}
        {% else %}
          {{ displayTitle or title }}
        {% endif %}
      </h1>
    </div>
    {% if summary %}
      <p class="course-summary">{{ summary }}</p>
    {% endif %}
  </div>
</section>

<section class="page-shell course-panel">
  {% if assessments %}
    <div class="course-block course-assessments">
      <h2>Assessments</h2>
      <ul>
        {% for item in assessments %}
          <li>
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.code }}</a>
            {% else %}
              <span>{{ item.code }}</span>
            {% endif %}
            {% if item.text %}
              <span> {{ item.text }}</span>
            {% endif %}
            {% if item.credits %}
              <span> - {{ item.credits }} credits</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if assessmentLinks %}
    <nav class="course-chip-row" aria-label="Course resources">
      {% if assessmentGroup %}
        {% for link in assessmentLinks %}
          {% if loop.index == assessmentGroup.start %}
            <div class="course-chip-group" aria-label="{{ assessmentGroup.ariaLabel or 'Assessment links' }}">
          {% endif %}

          <a
            class="course-chip{% if loop.index >= assessmentGroup.start and loop.index <= assessmentGroup.end %} course-chip-assessment{% endif %}"
            href="{{ link.url }}"
          >
            {{ link.label }}
          </a>

          {% if loop.index == assessmentGroup.end %}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for link in assessmentLinks %}
          <a class="course-chip" href="{{ link.url }}">{{ link.label }}</a>
        {% endfor %}
      {% endif %}
    </nav>
  {% endif %}

  <details class="course-statement" {% if statement and statement.open %}open{% endif %}>
    <summary>
      <span>{{ statement.title or "Assessment statement" }}</span>
      <span class="course-chevron" aria-hidden="true"></span>
    </summary>

    <div class="course-statement-body">
      {% if statement and statement.embedUrl %}
        <div class="course-embed-frame">
          <iframe
            src="{{ statement.embedUrl }}"
            title="{{ statement.title or 'Assessment statement' }}"
            loading="lazy"
            referrerpolicy="no-referrer"
          ></iframe>
        </div>
      {% elif statement and statement.downloadUrl %}
        <p>
          Assessment statement available here:
          <a href="{{ statement.downloadUrl }}">Open statement document</a>
        </p>
      {% else %}
        <p>Add an embedUrl or downloadUrl in this page frontmatter to show the statement file.</p>
      {% endif %}
    </div>
  </details>

  {% if postStatementEmbed and postStatementEmbed.url %}
    <section class="course-post-embed">
      {% if postStatementEmbed.embed and not postStatementEmbed.compact %}
        <div class="course-post-embed-head">
          <h2 class="section-title">{{ postStatementEmbed.title or "Activities Running This Week" }}</h2>
          {% if postStatementEmbed.linkUrl %}
            <a class="course-post-embed-link" href="{{ postStatementEmbed.linkUrl }}" target="_blank" rel="noopener noreferrer">
              {{ postStatementEmbed.linkText or "Open in new tab" }}
            </a>
          {% endif %}
        </div>

        {% if postStatementEmbed.note %}
          <p class="course-post-embed-note">{{ postStatementEmbed.note }}</p>
        {% endif %}
      {% else %}
        <div class="course-post-link-card">
          <div>
            <h2 class="section-title">{{ postStatementEmbed.title or "Middle School Woodwork" }}</h2>
            {% if postStatementEmbed.note %}
              <p class="course-post-embed-note">{{ postStatementEmbed.note }}</p>
            {% endif %}
          </div>

          {% if postStatementEmbed.linkUrl %}
            <a class="course-post-embed-link" href="{{ postStatementEmbed.linkUrl }}" target="_blank" rel="noopener noreferrer">
              {{ postStatementEmbed.linkText or "Open in new tab" }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if postStatementEmbed.embed %}
        <div class="course-post-embed-frame">
          <iframe
            src="{{ postStatementEmbed.url }}"
            title="{{ postStatementEmbed.title or 'Embedded site' }}"
            loading="lazy"
            referrerpolicy="no-referrer"
            style="height: {{ postStatementEmbed.height or 1400 }}px;"
          ></iframe>
        </div>
      {% endif %}
    </section>
  {% endif %}

  {% if not hideContent %}
    <div class="course-body">
      {% if lead %}
        <p class="course-lead">{{ lead }}</p>
      {% endif %}
      <div class="content-body">
        {{ content | safe }}
      </div>
    </div>
  {% endif %}
</section>
