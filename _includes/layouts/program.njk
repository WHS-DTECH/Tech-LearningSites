---
layout: layouts/base.njk
---
<section class="subject-masthead">
  <div class="page-shell subject-masthead-inner">
    <div class="subject-kicker">{{ shortTitle or title }}</div>
    <div class="subject-title-frame">
      <h1>{{ displayTitle or title }}</h1>
    </div>
    {% if summary %}
      <p class="subject-summary">{{ summary }}</p>
    {% endif %}
  </div>
</section>

<section class="page-shell subject-grid-wrap">
  <div class="subject-grid">
    {% for group in schoolGroups %}
      <article class="subject-column">
        <div class="subject-column-head">
          {% if group.icon %}
            <span class="subject-icon" aria-hidden="true">{{ group.icon }}</span>
          {% endif %}
          <div>
            <h2>{{ group.title }}</h2>
            {% if group.subtitle %}
              <p>{{ group.subtitle }}</p>
            {% endif %}
          </div>
        </div>
        <div class="subject-links">
          {% for link in group.links %}
            <a class="subject-link" href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="page-shell subject-calendar-wrap" data-subject-calendar>
  <article class="subject-calendar-card">
    <div class="subject-calendar-head">
      <div>
        <h2 class="section-title">Today's Calendar Events</h2>
        <p class="subject-calendar-date" data-subject-calendar-date>Loading today's date...</p>
      </div>
    </div>
    <div class="subject-calendar-table-wrap">
      <table class="subject-calendar-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Details</th>
            <th>Location</th>
          </tr>
        </thead>
        <tbody data-subject-calendar-events>
            <tr><td colspan="3">Loading today's events...</td></tr>
        </tbody>
      </table>
    </div>
  </article>
    <aside class="subject-calendar-details" aria-label="Calendar details and course names">
      <div class="relief-plan-details" id="relief-plan-details" aria-live="polite">
        <h2>Event details</h2>
        <p>Select an event in the calendar to view its description and source.</p>
      </div>
      <div class="subject-course-names">
        <h2>Relief Activity</h2>
        <ul>
          {% for group in schoolGroups or [] %}
            {% for link in group.links or [] %}
              <li>{{ link.label }}</li>
            {% endfor %}
          {% endfor %}
        </ul>
      </div>
    </aside>
</section>

{% if not activitySection and embeddedSection and embeddedSection.url %}
  <section class="page-shell subject-embed-wrap">
    <article class="subject-embed-card">
      <h2 class="section-title">{{ embeddedSection.title or "Activities running" }}</h2>
      {% if embeddedSection.description %}
        <p class="subject-embed-note">{{ embeddedSection.description }}</p>
      {% endif %}
      <div class="subject-embed-frame">
        <iframe
          src="{{ embeddedSection.url }}"
          title="{{ embeddedSection.title or 'Embedded activities' }}"
          loading="lazy"
          referrerpolicy="no-referrer"
          style="height: {{ embeddedSection.height or 960 }}px;"
        ></iframe>
      </div>
    </article>
  </section>
{% elseif not activitySection %}
  <section class="page-shell subject-info-panel">
    <div class="subject-info-copy">
      <h2 class="section-title">Current updates</h2>
      {% if lead %}
        <p>{{ lead }}</p>
      {% endif %}
      <div class="content-body">
        {{ content | safe }}
      </div>
    </div>

    {% if quickLinks %}
      <aside class="subject-side-panel">
        <h2>Useful links</h2>
        <div class="link-list">
          {% for link in quickLinks %}
            <a class="link-card" href="{{ link.url }}">
              <strong>{{ link.label }}</strong>
              <span>{{ link.description }}</span>
            </a>
          {% endfor %}
        </div>
      </aside>
    {% endif %}
  </section>
{% endif %}

<script>
  (() => {
    const calendar = document.querySelector("[data-subject-calendar]");
    if (!calendar) return;

    const dateLabel = calendar.querySelector("[data-subject-calendar-date]");
    const eventsBody = calendar.querySelector("[data-subject-calendar-events]");
    const today = new Date();
    const pad = (value) => String(value).padStart(2, "0");
    const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
    const displayDate = today.toLocaleDateString(undefined, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
    dateLabel.textContent = displayDate;

    const escapeHtml = (value) => String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

    const parseCsvDate = (value) => {
      const match = String(value || "").match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
      return match ? `${match[3]}-${match[1]}-${match[2]}` : "";
    };

    fetch("/api/relief-plan/events", { credentials: "same-origin" })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error("Staff access required")))
      .then((data) => {
        const todaysEvents = (data.events || []).filter((event) => parseCsvDate(event.startDate) <= todayKey && todayKey <= parseCsvDate(event.endDate || event.startDate));
        if (!todaysEvents.length) {
          eventsBody.innerHTML = '<tr><td colspan="3">No calendar events scheduled for today.</td></tr>';
          return;
        }

        eventsBody.innerHTML = todaysEvents.map((event) => `
          <tr>
            <th scope="row">${escapeHtml(event.subject)}</th>
            <td>${escapeHtml(event.description).replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">Source</a>')}</td>
            <td>${escapeHtml(event.location) || "-"}</td>
          </tr>
        `).join("");
      })
      .catch(() => {
        eventsBody.innerHTML = '<tr><td colspan="3">Sign in through Relief Plan to view today\'s calendar events.</td></tr>';
      });
  })();
</script>