---
layout: layouts/base.njk
---
<section class="subject-masthead">
  <div class="page-shell subject-masthead-inner">
    <div class="subject-kicker">{{ shortTitle or title }}</div>
    <div class="subject-title-frame">
      <h1>{{ displayTitle or title }}</h1>
    </div>
    {% if summary %}
      <p class="subject-summary">{{ summary }}</p>
    {% endif %}
  </div>
</section>

<section class="page-shell subject-grid-wrap">
  <div class="subject-grid">
    {% for group in schoolGroups %}
      <article class="subject-column">
        <div class="subject-column-head">
          {% if group.icon %}
            <span class="subject-icon" aria-hidden="true">{{ group.icon }}</span>
          {% endif %}
          <div>
            <h2>{{ group.title }}</h2>
            {% if group.subtitle %}
              <p>{{ group.subtitle }}</p>
            {% endif %}
          </div>
        </div>
        <div class="subject-links">
          {% for link in group.links %}
            <a class="subject-link" href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% if activitySection %}
  <section class="page-shell subject-activity-wrap">
    <article class="subject-activity-card">
      <div class="subject-activity-head">
        <div>
          <h2 class="section-title">{{ activitySection.title or "Activities Running This Week" }}</h2>
          {% if activitySection.description %}
            <p class="subject-activity-note">{{ activitySection.description }}</p>
          {% endif %}
          {% if activitySection.emptyMessage %}
            <p class="subject-activity-empty-message">{{ activitySection.emptyMessage }}</p>
          {% endif %}
        </div>

        {% if activitySection.linkUrl %}
          <a class="subject-activity-link" href="{{ activitySection.linkUrl }}" target="_blank" rel="noopener noreferrer">
            {{ activitySection.linkText or "Open in TECH-HUB" }}
          </a>
        {% endif %}
      </div>

      <div class="subject-activity-grid">
        {% for card in activitySection.cards or [] %}
          {% if card.placeholder %}
            <article class="subject-activity-item subject-activity-placeholder" aria-hidden="true">
              <div class="subject-activity-image-wrap"></div>
              <div class="subject-activity-copy">
                <h3>{{ card.title or "Recipe Slot" }}</h3>
                {% if card.summary %}
                  <p>{{ card.summary }}</p>
                {% endif %}
              </div>
            </article>
          {% else %}
            <a class="subject-activity-item" href="{{ activitySection.linkUrl or card.url }}" target="_blank" rel="noopener noreferrer">
              <div class="subject-activity-image-wrap">
                {% if card.image %}
                  <img src="{{ card.image }}" alt="{{ card.title }}">
                {% endif %}
              </div>
              <div class="subject-activity-copy">
                {% if card.meta %}
                  <p class="subject-activity-meta">{{ card.meta }}</p>
                {% endif %}
                <h3>{{ card.title }}</h3>
                <p>{{ card.summary }}</p>
                <span class="subject-activity-open">{{ activitySection.openLabel or "Open in TECH-HUB" }}</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </article>
  </section>
{% elseif embeddedSection and embeddedSection.url %}
  <section class="page-shell subject-embed-wrap">
    <article class="subject-embed-card">
      <h2 class="section-title">{{ embeddedSection.title or "Activities running" }}</h2>
      {% if embeddedSection.description %}
        <p class="subject-embed-note">{{ embeddedSection.description }}</p>
      {% endif %}
      <div class="subject-embed-frame">
        <iframe
          src="{{ embeddedSection.url }}"
          title="{{ embeddedSection.title or 'Embedded activities' }}"
          loading="lazy"
          referrerpolicy="no-referrer"
          style="height: {{ embeddedSection.height or 960 }}px;"
        ></iframe>
      </div>
    </article>
  </section>
{% else %}
  <section class="page-shell subject-info-panel">
    <div class="subject-info-copy">
      <h2 class="section-title">Current updates</h2>
      {% if lead %}
        <p>{{ lead }}</p>
      {% endif %}
      <div class="content-body">
        {{ content | safe }}
      </div>
    </div>

    {% if quickLinks %}
      <aside class="subject-side-panel">
        <h2>Useful links</h2>
        <div class="link-list">
          {% for link in quickLinks %}
            <a class="link-card" href="{{ link.url }}">
              <strong>{{ link.label }}</strong>
              <span>{{ link.description }}</span>
            </a>
          {% endfor %}
        </div>
      </aside>
    {% endif %}
  </section>
{% endif %}