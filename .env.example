# Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database

# Set to false for local plain Postgres if SSL errors occur.
# On Render this should usually remain unset.
DATABASE_SSL=true

# Temporary backend protection until Google OAuth is enabled.
ADMIN_API_KEY=replace-with-strong-random-key

# Separate secret used to sign admin session cookies.
ADMIN_SESSION_SECRET=replace-with-different-strong-random-key
